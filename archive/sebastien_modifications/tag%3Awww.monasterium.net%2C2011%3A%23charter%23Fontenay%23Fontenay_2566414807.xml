                  <cei:issued>
                     <cei:date value="11791231">[1171-1180]<cei:note>Date d’après
                        l’épiscopat de Gauthier à Langres, réduite par la mention de Manassès de
                        Bar-sur-Seine comme doyen, cf. <cei:bibl status="draft">
                              <cei:author>
                                 <cei:persName>
                                    <cei:surname>Flammarion</cei:surname>, <cei:forename>Hubert</cei:forename>
                                 </cei:persName>
                              </cei:author>: <cei:title>Cartulaire du chapitre cathédral de Langres</cei:title>.<cei:imprint>
                                 <cei:pubPlace>Turnhout</cei:pubPlace>
                                 <cei:publisher>Brepols</cei:publisher>
                                 <cei:date value="20049999">2004</cei:date>
                              </cei:imprint>
                              <cei:note type="tag">Langres (France) Church history Eglise catholique.
                Diocèse (Langres, Haute-Marne) -- Histoire -- Sources</cei:note>
                              <cei:scope>p.
                                57</cei:scope>
                           </cei:bibl>. Manasses de Bar-sur-Seine Girard de Montsaugeon, archidiacre du
                        Tonnerrois de 1154 à 1180, puis doyen du chapitre. Pierre de Bar, chanoine
                        de Langres de 1154 à 1197, doyen rural de Bar à partir de 1171. Belin,
                        chapelain de l’évêque, chanoine de Langres de 1157 à 1184. Bartholomeus
                        Coquille : attesté en 1178, cf. <cei:bibl status="draft">
                              <cei:author>
                                 <cei:persName>
                                    <cei:surname>Flammarion</cei:surname>, <cei:forename>Hubert</cei:forename>
                                 </cei:persName>
                              </cei:author>: <cei:title>Cartulaire du chapitre cathédral de Langres</cei:title>.<cei:imprint>
                                 <cei:pubPlace>Turnhout</cei:pubPlace>
                                 <cei:publisher>Brepols</cei:publisher>
                                 <cei:date value="20049999">2004</cei:date>
                              </cei:imprint>
                              <cei:note type="tag">Langres (France) Church history Eglise catholique.
                Diocèse (Langres, Haute-Marne) -- Histoire -- Sources</cei:note>Flammarion<cei:scope>p. 152</cei:scope>
                           </cei:bibl>
                        </cei:note>
                     </cei:date>
                  <cei:placeName/><cei:dateRange from="99999999" to="99999999"/></cei:issued>
