            <cei:body>
               <cei:idno id="Fontenay_871428580">Fontenay 871428580</cei:idno>
               <cei:chDesc>
                  <cei:issued>
                     <cei:date value="11320617" notBefore="1132-06-17" notAfter="1139-06-17">[1132-1139], 17 juin<cei:note>Date d'après l'épiscopat d'Étienne I d’Autun
                        (1112-1139) et l'abbatiat de Guillaume de Fontenay (1132-1154). En 1170-1171
                        se produit peut-être brièvement une occurrence similaire. Les trois mêmes
                        archidiacres (archidiaconibus Gaufrido, Seguino, Humberto) se retrouvent
                        dans une charte pour Fontenay donnée en 1147 (Cartulaire 1, fol. 40v-41r :
                        Flaciacum, 5). Les autres caractères internes (remise de dîme) comme les
                        caractères externes (caractéristiques paléographiques) imposent une datation
                        haute.</cei:note>
                     </cei:date>
                  <cei:placeName/><cei:dateRange from="99999999" to="99999999"/></cei:issued>
                  <cei:abstract>Etienne [Ier de Bâgé], évêque d’Autun, accédant à la requête de Guillaume,
                        abbé de Fontenay, dispense l'abbaye de Fontenay de payer les dîmes sur ses
                        possessions sises dans le diocèse d'Autun, notamment à Flacey.</cei:abstract>
                  <cei:witnessOrig>
                     <cei:traditioForm>Original</cei:traditioForm>
