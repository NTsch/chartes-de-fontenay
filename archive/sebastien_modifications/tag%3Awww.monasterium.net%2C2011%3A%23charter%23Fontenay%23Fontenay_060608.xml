                  <cei:placeName/><cei:dateRange from="99999999" to="99999999"/></cei:issued>
                  <cei:abstract>Henri [Ier], comte palatin de Troyes, agissant pour lui et ses successeurs,
                        dispense l’abbaye de Clairvaux et les abbayes dépendant d’elle de totu droit
                        de tonlieu, péage ou coutume sur ses terres ; il leur permet de vendre et
                        acheter en franchise à ses foires pour leur usage seulement.</cei:abstract>
                  <cei:witListPar>
                     <cei:witness n="A">Original perdu ; sceau perdu avant le <cei:hi rend="smallcaps">xvii</cei:hi>
                        <cei:hi rend="superscript">e</cei:hi> s.</cei:witness>
                     <cei:witness n="B">B. ADCO 15 H 13* (cart. 204), fol. 10<cei:hi rend="superscript">r</cei:hi> (Princes, G) : « <cei:hi rend="italic">Sola restat
                                corrigia.</cei:hi> »</cei:witness>
                     <cei:witness n="T">
                        <cei:hi rend="background(red)">Tradition parallèle ou original multiple : à
                                comparer à Veyssière, n° 28 et Billot</cei:hi>
