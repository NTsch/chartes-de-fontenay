               <cei:tenor>
                  <cei:pTenor>Ego <cei:persName key="P_Henricus_Trecensium_comes_palatinus_51855">Henricus <cei:placeName id="d1e151857" reg="Troyes">Trecensium</cei:placeName> comes palatinus</cei:persName>, servis Dei in
                        <cei:orgName id="d1e151861" reg="Abbaye de Clairvaux">Clara Valle</cei:orgName> et in abbatiis
                    pertinentibus ad eam degentibus pro anima mea et patris mei clementer indulgeo
                    ut in tota terra mea fratres eorum nullum omnino theloneum, nullum pedagium,
                    nullam consuetudinem exolvant ad nundinas meas, libere sine aliqua exactione
                    emant et vendant, quae usibus suis necessaria erunt, nec a ministris aut
                    officialibus meis molestiam aut gravamen seu injuriam aliquam patiantur, sed
                    homines mei in omnibus locis eis teneant pacem. Ut igitur integra eis et
                    illibata permaneant qua ob salutem animae meae illis concedo, nec istud
                    beneficium meum aliqua possit oblivione deleri, presentem cartam ad munimen
                    eorumdem fratrum conscribi et sigilli mei impressione insigniri et authoritate
                    precepi. Decerno etiam et indissolubili concessione confirmo ut haec pia donatio
                    mea, nullo in posterum tempore a successoribus et heredibus meis, nec a quoquam
                    hominum occasione qualibet infringatur. Hujus rei testes sunt <cei:persName key="P_Hilduinus_de_Vendopera_51864">Hilduinus de <cei:placeName id="d1e151866" reg="Vendopera">Vendopera</cei:placeName>
                     </cei:persName>, <cei:persName key="P_Walterius_de_Bernum_51869">Walterius de <cei:placeName id="d1e151871" reg="Bernon">
                           <cei:foreign lang="">Bernum</cei:foreign>
                        </cei:placeName>
                     </cei:persName>, <cei:persName key="P_Drogo_de_Pruvinio_51875">Drogo de <cei:placeName id="d1e151877" reg="Pruvinio">Pruvinio</cei:placeName>
                     </cei:persName>. Actum anno ab incarnatione Domini millesimo centesimo quinquagesimo
                    quarto, regnante <cei:persName key="P_Ludovico_Juniore_51881">Ludovico Juniore</cei:persName>,
                    Francorum rege christianissimo, <cei:persName key="P_Godefridus_abbas_Fonteneti_episcopus_Lingonensis_52394">Godefrido
                            <cei:placeName id="d1e151886" reg="Langres">Lingonensi</cei:placeName>
                    episcopo</cei:persName>. Tradita <cei:placeName id="d1e151890" reg="Bar-sur-Seine">Bar<cei:hi rend="background(red)">ro</cei:hi>
                     </cei:placeName> per manum <cei:persName key="P_Willelmi_notarii_51895">Willelmi notarii</cei:persName>.
                        <cei:hi rend="background(green)">Ego <cei:persName key="P_Johannes_quondam_Lugdunensis_archiepiscopus_51900">Johannes
                            quondam <cei:placeName id="d1e151902" reg="Lyon">Lugdunensis</cei:placeName>
                            archiepiscopus</cei:persName>, audita et perlecta in eadem verba coram me
                        originali carta in signum testimonii sigillum meum apposui.</cei:hi>
