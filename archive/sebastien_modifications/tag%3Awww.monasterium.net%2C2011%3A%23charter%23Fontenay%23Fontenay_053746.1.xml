               <cei:tenor>
                  <cei:pTenor>Ego <cei:persName key="P_Odo_III_dux_Burgundiae_70365">
                        <cei:app>
                           <cei:lem>O.</cei:lem>
                           <cei:rdg wit="#C">Odo</cei:rdg>
                        </cei:app>, dux <cei:placeName id="d1e166659" reg="Bourgogne">Burgundie</cei:placeName>
                     </cei:persName>, omnibus notum facio tam presentibus quam futuris quod <cei:persName key="P_Henricus_Arbelestarius_de_Monte_Barri_66662">Henricus Arbelestarius de <cei:placeName id="d1e166664" reg="Montbard">Monte Barri</cei:placeName>
                     </cei:persName> et <cei:persName key="P_uxor_ejus_66667">uxor ejus</cei:persName> guerpiverunt in
                    manibus nostris et penitus <cei:app>
                        <cei:lem>quitaverunt</cei:lem>
                        <cei:rdg wit="#C">quittaverunt</cei:rdg>
                     </cei:app> querelam quam habebant adversus fratres <cei:orgName id="d1e166676" reg="Abbaye de Fontenay">Fonteneti</cei:orgName> super quodam fossato quod fecerant dicti fratres ad
                    utilitatem <cei:placeName id="d1e166680" reg="molendini molendini sui quod est subtus abbatiam">
                        <cei:app>
                           <cei:lem>molendini</cei:lem>
                           <cei:rdg wit="#C">molendini sui</cei:rdg>
                        </cei:app> quod est subtus abbatiam</cei:placeName>. Concesserunt etiam
                    supranominati, <cei:persName key="P_Henricus_66688">Henricus</cei:persName> scilicet et
                        <cei:persName key="P_Maria_uxor_sua_66691">Maria uxor sua</cei:persName>, prelibatis fratribus
                        <cei:orgName id="d1e166694" reg="Abbaye de Fontenay">Fonteneti</cei:orgName>
                     <cei:app>
                        <cei:lem>quicquid</cei:lem>
                        <cei:rdg wit="#C">quidquid</cei:rdg>
                     </cei:app> juris a prefato <cei:placeName id="d1e166702" reg="molendino">molendino</cei:placeName>
                    versus <cei:placeName id="d1e166706" reg="Fontenay">abbatiam</cei:placeName> habebant tam in <cei:app>
                        <cei:lem>terris</cei:lem>
                        <cei:rdg wit="#C">pratis</cei:rdg>
                     </cei:app> quam in <cei:app>
                        <cei:lem>pratis</cei:lem>
                        <cei:rdg wit="#C">terris</cei:rdg>
                     </cei:app> et de his omnibus adversus omnes debitam garentiam promiserunt. Hoc totum
                    laudaverunt <cei:persName key="P_liberi_eorum_Henrici_scilicet_et_Marie_uxoris_sue_66721">liberi eorum, <cei:persName key="P_Henrici_66723">Henrici</cei:persName> scilicet et <cei:persName key="P_Marie_uxoris_sue_66726">Marie uxoris sue</cei:persName>
                     </cei:persName>, et ipse <cei:persName key="P_Henricus_66729">Henricus</cei:persName> habuit
                    propter hoc <cei:app>
                        <cei:lem>
                           <cei:num value="99999999">xxx</cei:num>
                           <cei:hi rend="superscript">a</cei:hi>
                        </cei:lem>
                        <cei:rdg wit="#C">viginti</cei:rdg>
                     </cei:app> libras <cei:app>
                        <cei:lem>divionensium</cei:lem>
                        <cei:rdg wit="#B">divioñ</cei:rdg>
                        <cei:rdg wit="#C">divionenses</cei:rdg>
                     </cei:app> de beneficio ecclesie et uxor ejus <cei:app>
                        <cei:lem>
                           <cei:num value="99999999">lx</cei:num>
                        </cei:lem>
                        <cei:rdg wit="#C">quadraginta</cei:rdg>
                     </cei:app> solidos pro laude. Actum est hoc anno verbi incarnati <cei:app>
                        <cei:lem>
                           <cei:num value="99999999">m° cc° xii°</cei:num>
                        </cei:lem>
                        <cei:rdg wit="#C">millesimo ducentesimo duodecimo</cei:rdg>
                     </cei:app>. Quod totum ut ratum sit presentem paginam sigilli mei munimine
                    roboravi.</cei:pTenor>
